# MiniMax 模型（OpenAI 兼容接口）
MINIMAX_API_KEY=替换为你的MiniMax_API_Key
MINIMAX_MODEL=MiniMax-Text-01
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# 数据库（本期仅 MySQL；连接层已抽象，未来可扩展其他适配器）
DB_URL=mysql+pymysql://user:password@127.0.0.1:3306/ubr?charset=utf8mb4

# 查询与限流
MAX_ROWS=200
QUERY_TIMEOUT=20

# 应用
HOST=0.0.0.0
PORT=8000
